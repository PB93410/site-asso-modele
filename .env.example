# Variables d’environnement — noms seulement, jamais de secrets dans ce fichier.
# En production : Netlify → Site configuration → Environment variables.
# En local : copier ce fichier en .env (ignoré par git).
#
# Le site public fonctionne SANS aucune de ces variables (données de src/data/
# et public/data/). Elles activent le formulaire d’essai, l’inscription et /bureau.

# ---- Espace /bureau ----
# Mot de passe partagé du bureau
BUREAU_PASSWORD=
# Mot de passe de la porte « Ce soir — essais » (coach / bénévole). Vide = porte absente.
BUREAU_PASSWORD_SEANCE=
# Chaîne aléatoire longue (signature des sessions)
BUREAU_SECRET=
# Domaine du site si différent de asso.config.js → siteUrl
# SITE_ORIGIN=https://www.exemple-asso.fr

# ---- Données du bureau ----
# Par défaut sur Netlify (rien à régler). Google Sheets si GOOGLE_SERVICE_ACCOUNT_JSON est rempli,
# ou pour forcer : STOCKAGE=netlify ou STOCKAGE=google. Voir docs/DOC-DONNEES.md.
# STOCKAGE=
# Sauvegarde Excel envoyée chaque lundi (stockage Netlify) : SAUVEGARDE_MAIL=non pour la couper.
# SAUVEGARDE_MAIL=
# Contrôle de nuit du site (pages et API d'essai, mail seulement en cas de panne) : CONTROLE_SITE=non pour le couper.
# CONTROLE_SITE=
# Rappel mensuel des essais de plus de 12 mois à supprimer (stockage Google) : PURGE_RAPPEL=non pour le couper.
# PURGE_RAPPEL=
# Relances de réinscription par mail (juin et septembre, modules adhesion + espace) : éteintes par défaut.
# « apercu » compte sans rien envoyer (lire le journal de la fonction), « oui » envoie.
# REINSCRIPTION_RELANCES=
# npm run donnees (exporter, restaurer, importer-google), en local seulement, jamais sur Netlify :
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=

# ---- Google Sheets (facultatif : compte de service, éditeur des classeurs) ----
# Contenu JSON complet de la clé du compte de service
GOOGLE_SERVICE_ACCOUNT_JSON=
# Classeur Adhérents
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=
# Classeur Essais
GOOGLE_SHEET_ESSAIS_ID=
GOOGLE_SHEET_ESSAIS_NAME=
# Classeur « contenu site » (onglets PLANNING et EVENEMENTS édités depuis /bureau)
GOOGLE_SITE_SHEET_ID=
# GOOGLE_SITE_TAB_PLANNING=PLANNING
# GOOGLE_SITE_TAB_EVENTS=EVENEMENTS
# Onglet des essais pris au stand du forum (archivage de saison)
# GOOGLE_FORUM_TAB=Forum

# ---- CSV publiés (facultatif, lus au build et par /api/sheet) ----
# Fichier → Partager → Publier sur le Web → onglet → CSV
SHEET_CSV_COACHS=
SHEET_CSV_EVENEMENTS=
SHEET_CSV_PLANNING=

# ---- Création des classeurs (npm run sheets:creer, en local seulement) ----
# Client OAuth « Application de bureau » du projet Google Cloud. Pas besoin sur Netlify.
GOOGLE_SETUP_CLIENT_ID=
GOOGLE_SETUP_CLIENT_SECRET=

# ---- Envoi des mails (alertes essai / adhésion, cartes) ----
# Voir docs/DOC-MAIL.md. Le premier réglé est utilisé : SMTP, puis Brevo, puis Gmail.
# Adresse de l’asso si différente de asso.config.js → email (expéditeur et boîte des alertes)
# MAIL_ASSO=
# La boîte mail de l’asso (OVH, Gandi, Infomaniak, Orange, Free, Gmail…)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Ou Brevo (clé API ; expéditeur validé dans Brevo)
BREVO_API_KEY=
# Pour forcer : smtp, brevo, gmail, ou aucun
# MAIL_ENVOI=

# ---- Boîte mail lue dans le bureau (module mail) ----
# IMAP de la boîte de l’asso ; utilisateur et mot de passe du SMTP par défaut.
IMAP_HOST=
IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# Copie des réponses dans « Envoyés » : IMAP_COPIE_ENVOYES=non pour la couper.
# IMAP_COPIE_ENVOYES=
# Pour forcer : imap ou gmail
# MAIL_BOITE=

# ---- Paiement de l’adhésion en ligne (docs/DOC-PAIEMENT.md) ----
# HelloAsso : Mon compte → Intégrations et API. L’adhésion passe « À jour » toute seule au paiement.
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# Nom court de l’asso dans l’adresse HelloAsso (après /associations/)
HELLOASSO_ORGANISATION=
# Environnement de test HelloAsso (aucun vrai paiement) : HELLOASSO_SANDBOX=1
# HELLOASSO_SANDBOX=
# Pour forcer : helloasso, lien (bouton vers adhesion.paiementUrl, pointage à la main) ou aucun
# PAIEMENT=

# ---- Agenda du bureau (docs/DOC-AGENDA.md) ----
# Sur Netlify par défaut ; dans Google Agenda si GOOGLE_REFRESH_TOKEN est présent. Pour forcer :
# AGENDA=netlify ou AGENDA=google
# AGENDA=
# Clé du lien d’abonnement .ics (par défaut tirée de BUREAU_SECRET). La changer coupe les anciens liens.
# AGENDA_ICS_CLE=

# ---- Compte Google de l’asso (OAuth : Mail, Agenda, Contacts du bureau) ----
# Voir docs/DOC-BUREAU-GOOGLE.md
# ASSO_GMAIL=  (par défaut : asso.config.js → email)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# GOOGLE_OAUTH_REDIRECT_URI=https://www.exemple-asso.fr/api/bureau/google/callback

# ---- Démo ----
# DEMO=1 : données fictives, sans Google (comme `npm run demo`). Jamais en production :
# `npm run verifier` le signale comme une erreur.
# DEMO=

# ---- Divers ----
# Sujet ntfy.sh pour un bip « nouvel essai » sur téléphone (facultatif)
BUREAU_NTFY_TOPIC=
# Préfixe des numéros d’adhérent si différent de <sigle>-<saison>- (ex. ASE-2627-)
# ADHERENT_PREFIX=
# Liste des cours acceptés par l’éditeur de planning, séparés par « ; » (facultatif)
# SITE_COURSES=Gym Douce;Pilates;Zumba
