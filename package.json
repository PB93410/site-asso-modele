{
  "name": "site-asso-modele",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "verifier": "node scripts/verifier.mjs",
    "installer": "node scripts/installer.mjs",
    "configurateur": "vite --config vite.configurateur.ts",
    "build:configurateur": "vite build --config vite.configurateur.ts",
    "build": "tsc -b && vite build && node scripts/fetch-sheets.mjs && node scripts/postbuild-seo.mjs && node scripts/prerender.mjs && node scripts/validate-schema.mjs",
    "build:fast": "vite build && node scripts/fetch-sheets.mjs && node scripts/postbuild-seo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "identite": "node scripts/make-identity.mjs",
    "prebuild": "npx puppeteer browsers install chrome || true",
    "seo": "node scripts/postbuild-seo.mjs",
    "schema": "node scripts/validate-schema.mjs",
    "sheets": "node scripts/fetch-sheets.mjs",
    "sheets:format": "node scripts/format-bureau-sheets.mjs",
    "sheets:site": "node scripts/seed-site-sheet.mjs",
    "prerender": "node scripts/prerender.mjs",
    "deploy:prod": "npx --yes netlify-cli deploy --prod --dir=dist --functions=netlify/functions --no-build",
    "deploy:prod:seo": "npm run build && npm run deploy:prod"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "@resvg/resvg-wasm": "^2.6.2",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "puppeteer": "^25.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "description": "Modèle de site pour association à activité récurrente : vitrine, essai gratuit, inscription et espace bureau (React + Vite + Netlify)."
}
